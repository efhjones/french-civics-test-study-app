# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012  # Get from: aws sts get-caller-identity

# LLM Configuration (choose one)
# Option 1: AWS Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Option 2: OpenAI API
# OPENAI_API_KEY=sk-proj-...  # Get from: https://platform.openai.com/api-keys

# DynamoDB Table Names (will be created by CDK)
USERS_TABLE=FrenchCivics-Users
TOPICS_TABLE=FrenchCivics-Topics
QUESTIONS_TABLE=FrenchCivics-Questions
RESULTS_TABLE=FrenchCivics-UserQuestionResults
STATS_TABLE=FrenchCivics-UserStats

# S3 Bucket (will be created by CDK)
LIVRET_BUCKET=french-civics-livret-content-dev

# Cognito (will be populated after CDK deployment)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# API Gateway (will be populated after CDK deployment)
API_GATEWAY_URL=

# Environment
ENVIRONMENT=development
